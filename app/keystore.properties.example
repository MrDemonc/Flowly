# Archivo de configuración para firmar la APK de release.
# Copia este archivo como keystore.properties y completa tus datos.
# El archivo keystore.properties está en .gitignore y NUNCA debe subirse al repositorio.

storePassword=tu-contraseña-del-keystore
keyPassword=tu-contraseña-de-la-clave
keyAlias=tu-alias
storeFile=keystore.jks
